{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pagepilot-preview",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-16",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"r2_buckets": [
		{
			"binding": "PAGES",
			"bucket_name": "pagepilot-preview"
		}
	],
	"env": {
		"production": {
			"name": "pagepilot",
			"workers_dev": false,
			"preview_urls": false,
			"observability": {
				"logs": {
					"enabled": true,
					"invocation_logs": true,
					"persist": true
				}
			},
			"routes": [
				{
					"pattern": "pagepilot.rafay99.com",
					"custom_domain": true
				}
			],
			"vars": {
				"PUBLIC_URL": "https://pagepilot.rafay99.com"
			},
			"r2_buckets": [
				{
					"binding": "PAGES",
					"bucket_name": "pagepilot"
				}
			],
		},
	},
}