{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagepilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
  "r2_buckets": [
    {
      "binding": "PAGES",
      "bucket_name": "html-slop",
    },
  ],
  "env": {
    "production": {
      "name": "pagepilot",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true,
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      "routes": [
        {
          "pattern": "pagepilot.rafay99.com",
          "custom_domain": true,
        },
      ],
      "assets": {
        "directory": "./dashboard/dist",
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      "vars": {
        "PUBLIC_URL": "https://pagepilot.rafay99.com",
      },
      "r2_buckets": [
        {
          "binding": "PAGES",
          "bucket_name": "html-slop",
        },
      ],
    },
  },
}
